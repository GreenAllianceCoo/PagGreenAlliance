# Variables de entorno de Green Alliance. Copia este archivo y llena los valores.
# - Producción (Vercel / `npm run build`): .env.local o el panel de Vercel.
# - Desarrollo (`npm run dev` contra Supabase LOCAL): .env.development.local
#   (las llaves locales salen de `npx supabase status`).
# Nunca subas valores reales al repositorio.

# --- Supabase (Settings > API) -------------------------------------------
# Públicas: van al navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO servidor (lib/supabase/admin.ts, con `import "server-only"`).
# Salta RLS: jamás en un componente cliente ni con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingreso con código ----------------------------------------------------
# SOLO servidor. Secreto de 32+ caracteres para cifrar (AES-256-GCM) la cookie
# del paso 1 → paso 2. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INGRESO_COOKIE_SECRET=

# --- Límite de intentos (ingreso y afiliación) -----------------------------
# SOLO servidor. Secreto de 32+ caracteres para la clave HMAC-SHA256 que se
# guarda en public.limites_intentos (lib/servidor/limite.ts). Debe ser distinto
# de INGRESO_COOKIE_SECRET. Generar igual que el anterior.
# Si falta: el build en Vercel falla (next.config.mjs) y, en tiempo de
# ejecución, el ingreso y la afiliación se bloquean y se registra
# `limite_secreto_faltante`. Cambiarlo reinicia los contadores (ventana máx. 1 día).
LIMITE_HMAC_SECRET=

# --- Correos a los asociados (Resend) --------------------------------------
# SOLO servidor. Si Resend falla o falta configuración, la acción sigue y se
# registra el error. Plantillas y variables en docs/resend-plantillas.md.
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej.: Cooperativa Green Alliance <no-responder@dominio.com>
EMAIL_FROM=
# Alias o ID de plantillas publicadas en Resend.
RESEND_TEMPLATE_INGRESO_ACEPTADO=
RESEND_TEMPLATE_CREDITO_APROBADO=
RESEND_TEMPLATE_CREDITO_RECHAZADO=
RESEND_TEMPLATE_SORTEO_BOLETA=

# --- Contacto ---------------------------------------------------------------
# Número de WhatsApp SIN +57 (10 dígitos). Se usa en enlaces https://wa.me/57<NÚMERO>.
# Si está vacío, se muestra el texto sin enlace.
NEXT_PUBLIC_WHATSAPP=
